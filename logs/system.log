```python
import pandas as pd
import matplotlib.pyplot as plt

# Group by Region and calculate total Units Sold and average Unit Price
region_sales = df.groupby('Region')[['Units Sold', 'Unit Price']].agg(['sum', 'mean'])

# Print the results
print("Total Units Sold and Average Unit Price by Region:")
print(region_sales)

# Group by Product and calculate total Units Sold and average Unit Price
product_sales = df.groupby('Product')[['Units Sold', 'Unit Price']].agg(['sum', 'mean'])

# Print the results
print("\nTotal Units Sold and Average Unit Price by Product:")
print(product_sales)

# Calculate the price range for each product
product_price_range = df.groupby('Product')['Unit Price'].agg(['min', 'max'])

# Print the results
print("\nPrice Range for Each Product:")
print(product_price_range)

# Plot the price range for each product
plt.figure(figsize=(10, 6))
plt.bar(product_price_range.index, product_price_range['max'] - product_price_range['min'])
plt.xlabel('Product')
plt.ylabel('Price Range')
plt.title('Price Range for Each Product')
plt.savefig('output_plot.png')
print("\nPrice Range for Each Product (Plot saved to output_plot.png)")

# Calculate the average price range for each category
category_price_range = df.groupby('Category')['Unit Price'].agg(['min', 'max']).mean(axis=1)

# Print the results
print("\nAverage Price Range for Each Category:")
print(category_price_range)

# Plot the average price range for each category
plt.figure(figsize=(10, 6))
plt.bar(category_price_range.index, category_price_range)
plt.xlabel('Category')
plt.ylabel('Average Price Range')
plt.title('Average Price Range for Each Category')
plt.savefig('output_plot.png')
print("\nAverage Price Range for Each Category (Plot saved to output_plot.png)")
```

This code will generate two plots: one for the price range of each product and another for the average price range of each category. The plots will be saved to 'output_plot.png'. The key findings will be printed to standard output.

