import pandas as pd
import matplotlib.pyplot as plt

# Assuming the DataFrame 'df' is already loaded

# Convert 'Date' column to datetime type for easier date-based analysis
df['Date'] = pd.to_datetime(df['Date'])

# Extract country from 'Region' column (assuming 'North', 'South', 'East' represent different countries)
df['Country'] = df['Region'].str.replace(' ', '')

# Group by 'Country' and calculate total revenue, units sold, and profit
country_summary = df.groupby('Country').agg({
    'Revenue': 'sum',
    'Units Sold': 'sum',
    'Profit': 'sum'
})

# Print country summary
print(country_summary)

# Plot a bar chart to compare total revenue across countries
plt.figure(figsize=(10, 6))
plt.bar(country_summary.index, country_summary['Revenue'])
plt.xlabel('Country')
plt.ylabel('Total Revenue')
plt.title('Total Revenue by Country')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('output_plot.png')

# Print the top 3 countries with the highest total revenue
top_countries = country_summary.nlargest(3, 'Revenue')
print(top_countries)
```

This code will generate a bar chart comparing total revenue across countries and print the top 3 countries with the highest total revenue. The chart will be saved as 'output_plot.png'.

