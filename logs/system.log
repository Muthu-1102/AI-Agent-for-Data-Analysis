plt.figure(figsize=(10, 6))
plt.bar(merged_df['Country'], merged_df['UnitPrice'], label='Mean Unit Price')
plt.xlabel('Country')
plt.ylabel('Mean Unit Price')
plt.title('Country-wise Mean Unit Price')
plt.xticks(rotation=90)
plt.tight_layout()
plt.savefig('output_plot.png')
print("Plot saved to 'output_plot.png'")
