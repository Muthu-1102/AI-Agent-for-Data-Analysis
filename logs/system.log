import pandas as pd
import matplotlib.pyplot as plt

# Group customers by unit price and calculate total quantity
df_grouped = df.groupby('UnitPrice')['Quantity'].sum().reset_index()

# Split customers into two groups based on the median unit price
median_unit_price = df_grouped['UnitPrice'].median()
df_low_unit_price = df_grouped[df_grouped['UnitPrice'] <= median_unit_price]
df_high_unit_price = df_grouped[df_grouped['UnitPrice'] > median_unit_price]

# Print key findings
print("Customers with low unit price:")
print(df_low_unit_price)
print("\nCustomers with high unit price:")
print(df_high_unit_price)

# Generate a bar chart to visualize the results
plt.figure(figsize=(10, 6))
plt.bar(df_low_unit_price['UnitPrice'], df_low_unit_price['Quantity'], label='Low Unit Price')
plt.bar(df_high_unit_price['UnitPrice'], df_high_unit_price['Quantity'], label='High Unit Price')
plt.xlabel('Unit Price')
plt.ylabel('Total Quantity')
plt.title('Customer Split by Unit Price')
plt.legend()
plt.savefig('output_plot.png')
plt.show()
```

