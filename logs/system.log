import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Analyze the dataset based on the salary
def analyze_salary(df):
    # Calculate the mean, median, and standard deviation of salaries
    mean_salary = df['salary'].mean()
    median_salary = df['salary'].median()
    std_salary = df['salary'].std()

    print(f"Mean Salary: ${mean_salary:,.2f}")
    print(f"Median Salary: ${median_salary:,.2f}")
    print(f"Standard Deviation of Salaries: ${std_salary:,.2f}")

    # Calculate the top 10% and bottom 10% of salaries
    top_10_percent = df['salary'].quantile(0.9)
    bottom_10_percent = df['salary'].quantile(0.1)

    print(f"Top 10% of Salaries: ${top_10_percent:,.2f}")
    print(f"Bottom 10% of Salaries: ${bottom_10_percent:,.2f}")

    # Plot a histogram of salaries
    plt.figure(figsize=(10, 6))
    sns.histplot(df['salary'], bins=20, kde=True)
    plt.title("Histogram of Salaries")
    plt.xlabel("Salary")
    plt.ylabel("Frequency")
    plt.savefig('output_plot.png')
    print("Histogram of Salaries saved to output_plot.png")

    # Print the number of employees in each department with a salary above the median
    above_median_departments = df[df['salary'] > median_salary]['department'].value_counts()
    print("Departments with a salary above the median:")
    print(above_median_departments)

# Call the function to analyze the salary
analyze_salary(df)
```

This code will analyze the dataset based on the salary, calculate the mean, median, and standard deviation of salaries, and print the top 10% and bottom 10% of salaries. It will also plot a histogram of salaries and save it to 'output_plot.png'. Finally, it will print the number of employees in each department with a salary above the median.

