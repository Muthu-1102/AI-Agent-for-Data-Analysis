```python
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Analyze the dataset based on the genre
def analyze_genre(df):
    # Group by genre and calculate the mean popularity, vote count, and vote average
    genre_stats = df.groupby('Genre').agg({
        'Popularity': 'mean',
        'Vote_Count': 'mean',
        'Vote_Average': 'mean'
    }).reset_index()

    # Print the genre statistics
    print("Genre Statistics:")
    print(genre_stats)

    # Find the top 3 genres with the highest mean popularity
    top_genres = genre_stats.nlargest(3, 'Popularity')
    print("\nTop 3 Genres by Mean Popularity:")
    print(top_genres)

    # Find the top 3 genres with the highest mean vote count
    top_genres = genre_stats.nlargest(3, 'Vote_Count')
    print("\nTop 3 Genres by Mean Vote Count:")
    print(top_genres)

    # Find the top 3 genres with the highest mean vote average
    top_genres = genre_stats.nlargest(3, 'Vote_Average')
    print("\nTop 3 Genres by Mean Vote Average:")
    print(top_genres)

    # Plot a bar chart of the top 3 genres by mean popularity
    sns.set()
    plt.figure(figsize=(10, 6))
    sns.barplot(x='Genre', y='Popularity', data=top_genres.head(3))
    plt.title('Top 3 Genres by Mean Popularity')
    plt.xlabel('Genre')
    plt.ylabel('Mean Popularity')
    plt.savefig('output_plot.png')
    print("\nPlot saved to output_plot.png")

# Call the function to analyze the genre
analyze_genre(df)
```

This code analyzes the dataset based on the genre, calculates the mean popularity, vote count, and vote average for each genre, and prints the top 3 genres by each metric. It also generates a bar chart of the top 3 genres by mean popularity and saves it to 'output_plot.png'.

