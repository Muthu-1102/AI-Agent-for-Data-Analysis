import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Analyze the dataset
def analyze_dataset(df):
    # 1. Overview of the dataset
    print("Dataset Overview:")
    print(df.head())
    print(df.info())
    print(df.describe())

    # 2. Distribution of satisfaction levels
    satisfaction_levels = df['satisfaction_level']
    print("\nSatisfaction Levels Distribution:")
    print(satisfaction_levels.value_counts(normalize=True) * 100)

    # 3. Average monthly hours by department
    avg_monthly_hours_by_dept = df.groupby('Department')['average_montly_hours'].mean()
    print("\nAverage Monthly Hours by Department:")
    print(avg_monthly_hours_by_dept)

    # 4. Employees who left the company
    employees_who_left = df[df['left'] == 1]
    print("\nEmployees Who Left the Company:")
    print(employees_who_left.head())

    # 5. Promotion last 5 years by department
    promotion_last_5_years_by_dept = df.groupby('Department')['promotion_last_5years'].mean()
    print("\nPromotion Last 5 Years by Department:")
    print(promotion_last_5_years_by_dept)

    # 6. Salary distribution
    salary_distribution = df['salary'].value_counts(normalize=True) * 100
    print("\nSalary Distribution:")
    print(salary_distribution)

    # 7. Correlation between features
    correlation_matrix = df.corr()
    print("\nCorrelation Matrix:")
    print(correlation_matrix)

    # 8. Scatter plot of satisfaction level vs last evaluation
    plt.figure(figsize=(10, 6))
    sns.scatterplot(x='last_evaluation', y='satisfaction_level', data=df)
    plt.title('Satisfaction Level vs Last Evaluation')
    plt.xlabel('Last Evaluation')
    plt.ylabel('Satisfaction Level')
    plt.savefig('output_plot.png')
    print("\nScatter Plot of Satisfaction Level vs Last Evaluation Saved to output_plot.png")

# Call the function
analyze_dataset(df)
```

This script will generate a detailed analysis of the dataset, including an overview, distribution of satisfaction levels, average monthly hours by department, employees who left the company, promotion last 5 years by department, salary distribution, correlation between features, and a scatter plot of satisfaction level vs last evaluation. The results will be printed to standard output, and the scatter plot will be saved to 'output_plot.png'.

