import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Analyze the dataset
def analyze_dataset(df):
    # 1. Overview of the dataset
    print("Dataset Overview:")
    print(df.head())
    print(df.info())
    print(df.describe())

    # 2. Distribution of satisfaction levels
    satisfaction_levels = df['satisfaction_level'].value_counts()
    print("\nSatisfaction Levels Distribution:")
    print(satisfaction_levels)

    # 3. Average monthly hours by department
    avg_monthly_hours_by_dept = df.groupby('Department')['average_montly_hours'].mean()
    print("\nAverage Monthly Hours by Department:")
    print(avg_monthly_hours_by_dept)

    # 4. Number of projects by department
    num_projects_by_dept = df.groupby('Department')['number_project'].mean()
    print("\nNumber of Projects by Department:")
    print(num_projects_by_dept)

    # 5. Left employees by department
    left_employees_by_dept = df.groupby('Department')['left'].mean()
    print("\nLeft Employees by Department:")
    print(left_employees_by_dept)

    # 6. Salary distribution
    salary_counts = df['salary'].value_counts()
    print("\nSalary Distribution:")
    print(salary_counts)

    # 7. Correlation between variables
    corr_matrix = df.corr()
    print("\nCorrelation Matrix:")
    print(corr_matrix)

    # 8. Scatter plot of satisfaction level vs last evaluation
    plt.figure(figsize=(10, 6))
    sns.scatterplot(x='last_evaluation', y='satisfaction_level', data=df)
    plt.title('Satisfaction Level vs Last Evaluation')
    plt.xlabel('Last Evaluation')
    plt.ylabel('Satisfaction Level')
    plt.savefig('output_plot.png')
    print("\nScatter Plot of Satisfaction Level vs Last Evaluation saved to output_plot.png")

# Run the analysis
analyze_dataset(df)
```

